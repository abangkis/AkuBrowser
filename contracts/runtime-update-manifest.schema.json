{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akubrowser.local/contracts/runtime-update-manifest.schema.json",
  "title": "AkuBrowser signed Windows runtime update manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "product": {
      "type": "string",
      "const": "AkuBrowser"
    },
    "channel": {
      "type": "string",
      "const": "stable"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "runtimeRevision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "bridgeContractVersion": {
      "type": "string",
      "const": "aku-browser.bridge.v2"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/abangkis/AkuBrowser/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?/AkuBrowserRuntime-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?-windows-x64\\.zip$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["url", "size", "sha256"],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "const": "aku-runtime-stable-v1"
        },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88
        }
      },
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "channel",
    "version",
    "runtimeRevision",
    "bridgeContractVersion",
    "publishedAt",
    "artifact",
    "signature"
  ],
  "additionalProperties": false
}
