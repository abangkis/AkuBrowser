{
  "name": "@aku-browser/integration",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "AkuBrowser architecture, canonical contracts, and cross-repository development orchestration",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/run-go.mjs run ./cmd/akusidecar --config config/sidecar.json",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../AkuSidecar/scripts/build-dev.ps1",
    "restart:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../AkuSidecar/scripts/restart-dev.ps1",
    "dev": "npm run restart:sidecar",
    "check": "npm run check:contracts && npm run check:bridge && npm run check:sidecar",
    "check:contracts": "node scripts/check-contract-sync.mjs",
    "check:bridge": "npm --prefix ../AkuBridge run check",
    "check:sidecar": "node scripts/run-go.mjs test -p 1 ./...",
    "doctor": "node scripts/doctor.mjs",
    "package:bridge": "npm --prefix ../AkuBridge run package:verify",
    "smoke:http": "node scripts/run-go.mjs test -c -o runtime/dev/httpapi-smoke.test.exe ./internal/httpapi && ..\\AkuSidecar\\runtime\\dev\\httpapi-smoke.test.exe -test.run TestHealthAndBootstrapExposeGoBoundary",
    "smoke:codex": "node scripts/run-go.mjs test -c -o runtime/dev/reasoning-smoke.test.exe ./internal/reasoning && ..\\AkuSidecar\\runtime\\dev\\reasoning-smoke.test.exe -test.run TestCodexAppServerUsesOneManagedStructuredTransport"
  }
}
