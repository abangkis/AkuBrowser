{
  "schemaVersion": 1,
  "product": "AkuBrowser",
  "version": "0.7.1",
  "channel": "preview",
  "distribution": {
    "authorityRepository": "AkuBrowser",
    "windows": {
      "architecture": "x64",
      "format": "portable-zip",
      "launcher": "Start-AkuBrowser.cmd"
    },
    "macos": {
      "architectures": [
        "x64",
        "arm64"
      ],
      "format": "portable-zip",
      "launcher": "Start-AkuBrowser.command",
      "dataDirectory": "~/Library/Application Support/AkuBrowser/data"
    },
    "localOrigins": [
      "http://127.0.0.1:11122",
      "http://localhost:11122"
    ],
    "akuBridgeInstallation": "manual-unpacked"
  },
  "components": {
    "akuSidecar": {
      "version": "0.7.1",
      "runtime": "go"
    },
    "akuBridge": {
      "version": "0.7.1",
      "chromeVersion": "0.7.1.0",
      "runtimeRevision": "source-adapters-v79",
      "contractVersion": "aku-browser.bridge.v2"
    }
  },
  "bundle": {
    "includes": [
      "AkuSidecar",
      "AkuBridge unpacked payload",
      "Windows launcher and release configuration",
      "macOS launcher and release configuration",
      "Release provenance and SHA-256 checksums"
    ],
    "excludes": [
      "AkuSupervisor",
      "AkuSupervisorConformance"
    ]
  },
  "previewPrerequisites": [
    "Codex App with Codex App Server installed and locally signed in",
    "Google Chrome with every enabled source (X, LinkedIn, or Facebook) already signed in",
    "Manual AkuBridge installation through Chrome Developer mode"
  ]
}
