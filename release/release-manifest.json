{
  "schemaVersion": 2,
  "product": "AkuBrowser",
  "version": "0.8.0",
  "channel": "stable",
  "distribution": {
    "authorityRepository": "AkuBrowser",
    "windows": {
      "architecture": "x64",
      "format": "portable-zip",
      "launcher": "Start-AkuBrowser.cmd"
    },
    "macos": {
      "architectures": [
        "x64",
        "arm64"
      ],
      "format": "portable-zip",
      "launcher": "Start-AkuBrowser.command",
      "dataDirectory": "~/Library/Application Support/AkuBrowser/data"
    },
    "chromeStore": {
      "extensionDistribution": "chrome-web-store",
      "bridgeIdentityProfile": "production-store",
      "nativeRuntimeInstallers": {
        "windows-x64": {
          "status": "stable-unsigned",
          "format": "unsigned-user-scoped-exe",
          "trustState": "unsigned",
          "stableAsset": "AkuBrowserRuntimeSetup.exe",
          "updateManifest": "AkuSidecarUpdate.json",
          "legacyUpdateManifestV1": "AkuBrowserRuntimeUpdate.json",
          "hostRegistration": "HKCU",
          "dataDirectory": "%LOCALAPPDATA%\\AkuBrowser\\data"
        },
        "macos-universal": {
          "status": "stable-unsigned",
          "format": "unsigned-user-scoped-pkg",
          "trustState": "unsigned",
          "stableAsset": "AkuBrowserRuntimeSetup.pkg",
          "updateManifest": "AkuSidecarUpdate-macos-universal.json",
          "legacyUpdateManifestV1": "AkuBrowserRuntimeUpdate-macos-universal.json",
          "hostRegistration": "~/Library/Application Support/Google/Chrome/NativeMessagingHosts",
          "dataDirectory": "~/Library/Application Support/AkuBrowser/data"
        },
        "linux-x64": {
          "status": "planned-0.7.10",
          "format": "deb-with-portable-tar-fallback"
        },
        "linux-arm64": {
          "status": "planned-0.7.10",
          "format": "deb-with-portable-tar-fallback"
        }
      },
      "nativeHost": {
        "name": "com.akubrowser.runtime",
        "role": "internal-update-and-launch-helper",
        "version": "0.8.0",
        "protocolVersion": 2,
        "minimumProtocolVersion": 1
      }
    },
    "offlineBundle": {
      "extensionDistribution": "unpacked-offline",
      "bridgeIdentityProfile": "production-offline",
      "runtimeInstallKind": "portable",
      "installation": "load-unpacked-and-run-bundled-runtime"
    },
    "installedApp": {
      "status": "staged-builder",
      "bridgeIdentityProfile": "production-app",
      "format": "windows-x64-installed-app-tuple",
      "builder": "scripts/build-windows-installed-app.ps1",
      "installerBuilder": "scripts/build-windows-installed-app-installer.ps1",
      "installerStatus": "not-shipped",
      "signedInstaller": false,
      "database": {
        "currentSchemaVersion": 10,
        "acceptedInputSchemaVersions": [7, 8, 9, 10],
        "rollbackStatus": "not-implemented"
      }
    },
    "localOrigins": [
      "http://127.0.0.1:11122",
      "http://localhost:11122"
    ],
    "akuBridgeInstallation": {
      "store": "chrome-web-store",
      "offline": "load-unpacked-from-bundle"
    }
  },
  "components": {
    "akuSidecar": {
      "version": "0.8.0",
      "runtime": "go",
      "runtimeRevision": "source-adapters-v106",
      "update": {
        "minHostVersion": "0.7.9",
        "bridgeCompatibility": {
          "protocol": "aku-browser.bridge",
          "minVersion": 2,
          "maxVersion": 2,
          "requiredCapabilities": [
            "probe_readiness",
            "probe_freshness",
            "recover_source_freshness",
            "collect_visible",
            "dispatch_background_commands",
            "detect_pending_content",
            "report_adapter_health",
            "report_capture_quality",
            "acquire_missing_media",
            "recapture_missing_media",
            "cache_passive_media_evidence",
            "lookup_passive_media_evidence",
            "observe_response_media_evidence",
            "extract_source_semantics",
            "report_frontier",
            "manage_source_tab_lifecycle",
            "manage_capture_window",
            "release_capture_surface",
            "preserve_working_tab",
            "report_source_events",
            "reload_self",
            "authority.read_only_bounded",
            "capture.bounded"
          ]
        },
        "databaseCompatibility": {
          "minSchemaVersion": 7,
          "maxSchemaVersion": 7,
          "rollbackSafe": true
        },
        "urgency": "routine"
      }
    },
    "akuBridge": {
      "version": "0.8.0",
      "chromeVersion": "0.8.0.0",
      "runtimeRevision": "source-adapters-v106",
      "contractVersion": "aku-browser.bridge.v2"
    },
    "c2paTool": {
      "version": "0.26.60",
      "sha256": "90cbcebe30250f8e8c53416d32ed86065dc04a23be86e4a2337f5cd1badfa0b7",
      "platformSha256": {
        "windows-x64": "90cbcebe30250f8e8c53416d32ed86065dc04a23be86e4a2337f5cd1badfa0b7",
        "macos-universal": "3fd3d51f90317f4cffe37b44b7e397392d92dc178dce609ba48e0bcee15420a6"
      },
      "sourcePolicy": "pinned-local-release-binary",
      "workspaceSource": "../SharedTemp/AkuBrowser/shared-tools/c2patool/0.26.60/windows-x64/c2patool.exe",
      "platformWorkspaceSource": {
        "windows-x64": "../SharedTemp/AkuBrowser/shared-tools/c2patool/0.26.60/windows-x64/c2patool.exe",
        "macos-universal": "AkuSidecar/runtime/dev/macos-universal/c2patool"
      },
      "upstreamAssets": {
        "macos-universal": {
          "url": "https://github.com/contentauth/c2pa-rs/releases/download/c2patool-v0.26.60/c2patool-v0.26.60-universal-apple-darwin.zip",
          "archiveSha256": "4ca9a8e0937ca28b9090c35e5af1a41c252023799b9bca07f27d974e9ea57beb",
          "sbomUrl": "https://github.com/contentauth/c2pa-rs/releases/download/c2patool-v0.26.60/c2patool-v0.26.60-universal-apple-darwin-sbom.json",
          "sbomSha256": "3dc16165d01e9fd2e556e43c577fbaff664bfd8ef8db287cef1563448f254c06"
        }
      },
      "license": "MIT OR Apache-2.0",
      "licenseSha256": {
        "mit": "89375a50de90d2dcaa04406086da832ad452ebcaf6ab402ef3d51b8401a67c71",
        "apache2": "86bdd5dafab77451044b6fd6d2efab23e3410ce658eb097f04c04f4f54aed62f"
      }
    }
  },
  "bundle": {
    "deployables": [
      "AkuBridge (Chrome Web Store extension or stable-ID offline bundle)",
      "AkuSidecar (platform installer and signed update archive)"
    ],
    "internalHelpers": [
      "Native Messaging Host for AkuSidecar launch and update handoff"
    ],
    "includes": [
      "AkuSidecar",
      "Platform-native c2patool 0.26.60 for local image provenance verification",
      "AkuBridge Chrome Web Store integration metadata",
      "Stable-ID unpacked AkuBridge for self-contained offline bundles",
      "Windows launcher and release configuration",
      "macOS launcher and release configuration",
      "Release provenance and SHA-256 checksums"
    ],
    "excludes": [
      "AkuSupervisor",
      "AkuSupervisorConformance"
    ]
  },
  "previewPrerequisites": [
    "Codex App with Codex App Server installed and locally signed in",
    "Google Chrome with every enabled source (X, LinkedIn, Facebook, or Instagram) already signed in",
    "AkuBridge installed from the Chrome Web Store for Store mode, or loaded from the bundled AkuBridge directory for offline mode"
  ]
}
